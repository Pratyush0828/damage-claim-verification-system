# Security
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Docker default)
DATABASE_URL=postgresql+psycopg://claimlens:claimlens@postgres:5432/claimlens
POSTGRES_DB=claimlens
POSTGRES_USER=claimlens
POSTGRES_PASSWORD=claimlens

# Browser access
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_URL=/api

# Storage: local or s3
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# AI: optional. Without a key, deterministic local analysis is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_LOCAL_ML=false
MAX_UPLOAD_MB=12

